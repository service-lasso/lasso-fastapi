{
  "id": "fastapi",
  "name": "FastAPI",
  "description": "Release-backed FastAPI app service migrated from the TypeRefinery donor service.",
  "version": "0.1.0",
  "enabled": true,
  "execservice": "@python",
  "ports": {
    "service": 8000
  },
  "env": {
    "API_HOST": "127.0.0.1",
    "API_PORT": "${SERVICE_PORT}",
    "SERVICE_DATA_PATH": "${SERVICE_ROOT}/runtime/data",
    "SERVICE_LOG_PATH": "${SERVICE_ROOT}/runtime/logs",
    "PYTHONUTF8": "1"
  },
  "globalenv": {
    "API_URL": "http://${API_HOST}:${API_PORT}",
    "API_PORT": "${API_PORT}"
  },
  "urls": [
    {
      "label": "API docs",
      "url": "http://${API_HOST}:${API_PORT}/docs",
      "kind": "local"
    },
    {
      "label": "health",
      "url": "http://${API_HOST}:${API_PORT}/healthcheck",
      "kind": "local"
    }
  ],
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-fastapi",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-fastapi-0.1.0-win32.zip",
        "archiveType": "zip",
        "command": "./lasso-fastapi.py",
        "args": []
      }
    }
  },
  "commandline": {
    "win32": "${SERVICE_ARTIFACT_ROOT}/lasso-fastapi.py"
  },
  "install": {
    "files": [
      {
        "path": "./runtime/data/.keep",
        "content": ""
      },
      {
        "path": "./runtime/logs/.keep",
        "content": ""
      }
    ]
  },
  "healthchecks": [
    {
      "id": "http-healthcheck",
      "type": "http",
      "url": "http://${API_HOST}:${API_PORT}/healthcheck",
      "expected_status": 200,
      "retries": 180,
      "interval": 500
    }
  ],
  "depend_on": ["@python"],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  }
}
